<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Aevalsistant</AssemblyName>
    <RootNamespace>Aevalsistant</RootNamespace>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.4.0</Version>
    <Product>Aevalsistant</Product>
    <Description>Keeps the PC awake while AI coding agents work and tells you when one finishes or needs you.</Description>
    <Authors>aevalmere</Authors>
    <Copyright>Copyright (c) 2026 aevalmere</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <Compile Remove="tests\**" />
    <EmbeddedResource Include="assets\avatar.png" LogicalName="avatar.png" />
    <EmbeddedResource Include="assets\sounds\done.wav" LogicalName="done.wav" />
    <EmbeddedResource Include="assets\sounds\needs-you.wav" LogicalName="needs-you.wav" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Core" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
